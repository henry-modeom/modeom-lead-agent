# Clé API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : active la recherche Google Maps (Places API "New" activée sur le projet Google Cloud)
GOOGLE_MAPS_API_KEY=

# Réglages optionnels
# LEAD_AGENT_MODEL=claude-opus-5-5
# LEAD_AGENT_EFFORT=medium        # low | medium | high : plus haut = plus fouillé et plus cher
# LEAD_AGENT_MAX_TURNS=40
# LEAD_AGENT_MAX_WEB_SEARCHES=40

# Mot de passe de l'interface (obligatoire si l'application est en ligne)
# APP_PASSWORD=
